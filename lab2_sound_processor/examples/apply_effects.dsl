print("[apply_effects] Initializing sound effects pipeline...")
if exists("tests/tests_data/wav_lib/media/Smoke.wav"):
    src = open_wav("tests/tests_data/wav_lib/media/Smoke.wav")
    dst = create_wav("processed_effects.wav")
    t0 = time("0:0:0")
    t3 = time("0:0:3")
    t6 = time("0:0:6")
    t9 = time("0:0:9")
    t12 = time("0:0:12")
    print("[apply_effects] Stage 1 (0-3s): Bass filter (low-frequency boost)")
    p1 = src.get_interval(t0, t3)
    p1.set_effect("bass")
    dst.write_interval(p1, t0, False)
    print("[apply_effects] Stage 2 (3-6s): High filter (raise_high)")
    p2 = src.get_interval(t3, t6)
    p2.set_effect("raise_high")
    dst.write_interval(p2, t3, False)
    print("[apply_effects] Stage 3 (6-9s): Overdrive distortion")
    p3 = src.get_interval(t6, t9)
    p3.set_effect("distorsion")
    dst.write_interval(p3, t6, False)
    print("[apply_effects] Stage 4 (9-12s): Aggressive bass (hach_lada)")
    p4 = src.get_interval(t9, t12)
    p4.set_effect("hach_lada")
    dst.write_interval(p4, t9, False)
    print("[apply_effects] Sound effects processing complete: processed_effects.wav created.")
else:
    print("[apply_effects] Error: source WAV media not found.")
